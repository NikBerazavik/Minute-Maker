# Telegram — this project's bot (separate from Friday's)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=        # openssl rand -hex 32

# Fireflies
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=       # signing secret from the Webhooks V2 setup page
FIREFLIES_LANGUAGE=auto          # transcription language for addToLiveMeeting; "auto" detects it, or a code like "th"
FIREFLIES_MINUTES_ALLOWANCE=     # optional, default 400 — the free plan's stored-minutes cap, reported by /space
FIREFLIES_MINUTES_WARN_AT=       # optional, default 320 — /space warns at or above this many minutes used

# LLM provider layer (lib/llm.js)
LLM_PROVIDER=anthropic          # anthropic | openrouter
LLM_MODEL=claude-sonnet-5       # on OpenRouter use vendor/model, e.g. anthropic/claude-sonnet-5
LLM_EXTRACT_MODEL=              # optional: hard override for BOTH model tiers at once (the escape hatch)
LLM_THINKING=                    # "adaptive" (default) for the chat loop and the Sonnet tier. Haiku always sends none.
LLM_MODEL_HAIKU=                # optional: the Haiku tier's model. Default claude-haiku-4-5-20251001.
LLM_MODEL_SONNET=               # optional: the Sonnet tier's model. Default claude-sonnet-5.
                                # For an OpenRouter trial set LLM_PROVIDER=openrouter and point both at
                                # namespaced ids (anthropic/claude-haiku-4-5, google/gemini-2.5-pro, ...).
NOTES_STATE_LABEL=              # optional, default "Pending Notes" — must match the Notion Select option exactly
NOTES_BACKSTOP_HOURS=           # optional, default 24 — how long a Notes page waits for Fireflies before giving up
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=             # only when LLM_PROVIDER=openrouter

# Notion — second, separate integration scoped to the Meetings DB only
NOTION_API_KEY=
NOTION_MEETINGS_DB_ID=

# Internal
INTERNAL_SECRET=                # openssl rand -hex 32 — guards the /promote background function

# Local only
DEPLOY_URL=                     # https://<site>.netlify.app — used by scripts/setup-webhook.js
